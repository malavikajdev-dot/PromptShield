# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ARMORIQ_API_KEY: Required for genuine ArmorIQ intent token attestation.
# Configured via server secrets. Never exposed to browser or client code.
ARMORIQ_API_KEY="ak_live_your_armoriq_api_key_here"

# Optional identifiers for ArmorIQ tenant scoping
USER_ID="alex.vance@promptshield.io"
AGENT_ID="promptshield-defense-agent"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
PORT=3000
